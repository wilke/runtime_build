
Bootstrap: localimage
From: {{base}}

%post -c /bin/bash
    export DEBIAN_FRONTEND=noninteractive
    export CONDA_PLUGINS_AUTO_ACCEPT_TOS="yes"

    conda_dir=/opt/conda-predict

    conda create -p $conda_dir --yes --quiet python=3.12 pip

    . /opt/miniforge/etc/profile.d/conda.sh
    conda activate $conda_dir

    # Install predict-structure CLI with all extras (cwl, rocrate, etc.)
    $conda_dir/bin/pip install --no-cache-dir "predict-structure[all] @ git+https://github.com/CEPI-dxkb/PredictStructureApp.git"

    # Install protein_compare — structure analysis/comparison tool
    $conda_dir/bin/pip install --no-cache-dir "git+https://github.com/wilke/protein_structure_analysis.git"

    # Symlink into /usr/local/bin for easy access
    ln -sf $conda_dir/bin/predict-structure /usr/local/bin/predict-structure
    ln -sf $conda_dir/bin/protein_compare /usr/local/bin/protein_compare

    # #98 guard: exactly ONE installation of predict_structure may exist in
    # the image. A second copy (e.g. in a tool env) is a stale-code hazard —
    # the esmfold2 runner ran June's code for two months because a forgotten
    # duplicate shadowed every rebuild. Fail the build loudly instead.
    # readlink -f: conda ships a python3.1 -> python3.12 symlink, so a naive
    # glob counts the same install twice.
    n=$(ls -d /opt/conda-*/lib/python3.*/site-packages/predict_structure 2>/dev/null \
        | xargs -r readlink -f | sort -u | wc -l)
    if [ "$n" -ne 1 ]; then
        echo "FATAL: expected exactly 1 predict_structure install, found $n:" >&2
        ls -d /opt/conda-*/lib/python3.*/site-packages/predict_structure 2>/dev/null \
            | xargs -r readlink -f | sort -u >&2
        exit 1
    fi

    # Clean up
    conda clean --all --force-pkgs-dirs --yes
    $conda_dir/bin/pip cache purge

%environment
    export PATH=/opt/conda-predict/bin:$PATH

%runscript
    exec "$@"

%labels
    Description Unified protein structure prediction CLI (Boltz-2, Chai-1, AlphaFold2, ESMFold)
